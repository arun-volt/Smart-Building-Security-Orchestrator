#include <WiFi.h>
#include <WebServer.h>
#include <Keypad.h>
#include <ESP32Servo.h>

const char* ssid = "AK";
const char* password = "20012009";

// Keypad
const byte ROWS = 4; const byte COLS = 4;
char keys[ROWS][COLS] = {
  {'1','2','3','A'}, {'4','5','6','B'},
  {'7','8','9','C'}, {'*','0','#','D'}
};
byte rowPins[ROWS] = {19, 18, 5, 17};
byte colPins[COLS] = {16, 4, 2, 15};
Keypad keypad = Keypad(makeKeymap(keys), rowPins, colPins, ROWS, COLS);

// Pins
#define IR1_PIN 12  
#define IR2_PIN 14  
#define PIR_PIN 27
#define FIRE_PIN 26
#define BUZZER_PIN 25 // ஸ்ட்ரெய்ட்டா Buzzer (+) 
#define SERVO_PIN 23
#define RED_LED 21    // Danger / Armed
#define GREEN_LED 22  // Safe / Open

WebServer server(80);
Servo doorServo;

String enteredCode = "";
bool accessGranted = false;
bool alarmActive = false;

void handleStatus() {
  server.sendHeader("Access-Control-Allow-Origin", "*"); 
  String json = "{";
  json += "\"fire\": " + String(!digitalRead(FIRE_PIN)) + ",";
  json += "\"motion\": " + String(digitalRead(PIR_PIN)) + ",";
  json += "\"alarm\": " + String(alarmActive) + "}";
  server.send(200, "application/json", json);
}

void setup() {
  Serial.begin(115200);
  
  pinMode(IR1_PIN, INPUT); pinMode(IR2_PIN, INPUT);
  pinMode(PIR_PIN, INPUT); pinMode(FIRE_PIN, INPUT);
  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(RED_LED, OUTPUT); pinMode(GREEN_LED, OUTPUT);
  
  digitalWrite(RED_LED, HIGH); // கதவு லாக்ல இருந்தா Red எரியும்
  digitalWrite(GREEN_LED, LOW);
  digitalWrite(BUZZER_PIN, LOW);
  
  doorServo.attach(SERVO_PIN);
  doorServo.write(0); 
  
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) { delay(500); }
  
  Serial.println("\nFirst Floor ESP32 IP: "); Serial.println(WiFi.localIP());
  server.on("/status", handleStatus);
  server.begin();
}

void openDoorSequence() {
  accessGranted = true;
  digitalWrite(RED_LED, LOW);
  digitalWrite(GREEN_LED, HIGH); // Green எரியும்
  doorServo.write(90); 
  
  delay(5000); 
  
  int timeout = 30; 
  while((digitalRead(IR1_PIN) == LOW || digitalRead(IR2_PIN) == LOW) && timeout > 0) {
    delay(100); timeout--;
  }
  
  doorServo.write(0); 
  digitalWrite(GREEN_LED, LOW);
  digitalWrite(RED_LED, HIGH); // திரும்பவும் Red எரியும்
  accessGranted = false;
}

void loop() {
  server.handleClient();
  
  // Fire Alert 
  if (digitalRead(FIRE_PIN) == LOW) { 
    digitalWrite(BUZZER_PIN, HIGH);
    alarmActive = true;
  } else if (!alarmActive) { digitalWrite(BUZZER_PIN, LOW); }

  // Intruder/PIR Alert
  if (digitalRead(PIR_PIN) == HIGH && !accessGranted) {
    alarmActive = true;
    digitalWrite(BUZZER_PIN, HIGH); delay(100);
    digitalWrite(BUZZER_PIN, LOW); delay(100);
  }

  // AUTO-EXIT (IR2 Inside)
  if (digitalRead(IR2_PIN) == LOW && !accessGranted && !alarmActive) {
    openDoorSequence();
  }

  // KEYPAD
  char key = keypad.getKey();
  if (key) {
    if (key == '#') {
      if (enteredCode == "2727") {
        alarmActive = false;
        digitalWrite(BUZZER_PIN, LOW);
        openDoorSequence();
      } else {
        // தப்பான பாஸ்வேர்ட்
        alarmActive = true;
        for(int i=0; i<3; i++) { // 3 தடவை பீப் அடிக்கும்
            digitalWrite(BUZZER_PIN, HIGH); delay(500);
            digitalWrite(BUZZER_PIN, LOW); delay(200);
        }
        alarmActive = false;
      }
      enteredCode = ""; 
    } else if (key == '*') {
      enteredCode = ""; 
    } else {
      enteredCode += key; 
      // Key அமுக்கும் போது ஒரு குட்டி பீப் சத்தம்
      digitalWrite(BUZZER_PIN, HIGH); delay(50); digitalWrite(BUZZER_PIN, LOW);
    }
  }
}
